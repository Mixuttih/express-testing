@baseUrl = http://127.0.0.1:3000/api/v1
@userId = 37
@otherUserId = 38
@catId = 41
@otherCatId = 43
@username = blobba
@password = passworda
@adminUsername = temporary-admin-1794211027
@adminPassword = temporary-admin-password

### Public: get all cats
GET {{baseUrl}}/cats

### Public: get one cat
GET {{baseUrl}}/cats/{{catId}}

### Public: get cats owned by a user
GET {{baseUrl}}/cats/user/{{userId}}

### Public: get all users
GET {{baseUrl}}/users

### Public: get one user
GET {{baseUrl}}/users/{{userId}}

### Public: register a regular user
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Temporary User",
  "username": "temporary-{{$timestamp}}",
  "email": "temporary-{{$timestamp}}@example.com",
  "role": "user",
  "password": "temporary-password"
}

### Setup: create an admin user
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Temporary Admin",
  "username": "temporary-admin-{{$timestamp}}",
  "email": "temporary-admin-{{$timestamp}}@example.com",
  "role": "admin",
  "password": "temporary-admin-password"
}

### Public: login as a regular user
# @name loginUser
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### Authenticated: get the logged-in user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{loginUser.response.body.token}}

### Protected: create a cat
# The owner is taken from the token; the request body cannot assign another owner.
POST {{baseUrl}}/cats
Content-Type: application/json
Authorization: Bearer {{loginUser.response.body.token}}

{
  "cat_name": "Token-owned cat",
  "birthdate": "2022-04-20",
  "weight": 3.5,
  "owner": 999999,
  "filename": "/images/200.jpg"
}

### Protected: upload a cat image
POST {{baseUrl}}/cats
Content-Type: multipart/form-data; boundary=CatBoundary
Authorization: Bearer {{loginUser.response.body.token}}

--CatBoundary
Content-Disposition: form-data; name="name"

Uploaded cat
--CatBoundary
Content-Disposition: form-data; name="birthdate"

2023-10-08
--CatBoundary
Content-Disposition: form-data; name="weight"

6
--CatBoundary
Content-Disposition: form-data; name="owner"

999999
--CatBoundary
Content-Disposition: form-data; name="cat"; filename="cat_test.png"
Content-Type: image/png

< ./cat_test.png
--CatBoundary--

### Protected: regular user updates their own cat
PUT {{baseUrl}}/cats/{{catId}}
Content-Type: application/json
Authorization: Bearer {{loginUser.response.body.token}}

{
  "cat_name": "Updated by owner",
  "birthdate": "2022-04-20",
  "weight": 3.8,
  "owner": 999999
}

### Protected: regular user deletes their own cat
DELETE {{baseUrl}}/cats/{{catId}}
Authorization: Bearer {{loginUser.response.body.token}}

### Authorization check: regular user cannot update another user's cat
PUT {{baseUrl}}/cats/{{otherCatId}}
Content-Type: application/json
Authorization: Bearer {{loginUser.response.body.token}}

{
  "cat_name": "Should be rejected",
  "weight": 4
}

### Authorization check: regular user cannot delete another user's cat
DELETE {{baseUrl}}/cats/{{otherCatId}}
Authorization: Bearer {{loginUser.response.body.token}}

### Protected: regular user updates their own user record
PUT {{baseUrl}}/users/{{userId}}
Content-Type: application/json
Authorization: Bearer {{loginUser.response.body.token}}

{
  "name": "Updated User",
  "email": "updated@example.com",
  "password": "updated-password",
  "role": "admin"
}

### Authorization check: regular user cannot update another user
PUT {{baseUrl}}/users/{{otherUserId}}
Content-Type: application/json
Authorization: Bearer {{loginUser.response.body.token}}

{
  "name": "Should be rejected"
}

### Authorization check: regular user cannot delete another user
DELETE {{baseUrl}}/users/{{otherUserId}}
Authorization: Bearer {{loginUser.response.body.token}}

### Authentication check: missing token
GET {{baseUrl}}/auth/me

### Authentication check: malformed token
GET {{baseUrl}}/auth/me
Authorization: Basic not-a-bearer-token

### Admin: login
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "{{adminUsername}}",
  "password": "{{adminPassword}}"
}

### Admin: get the logged-in user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{loginAdmin.response.body.token}}

### Admin: update any cat
PUT {{baseUrl}}/cats/{{otherCatId}}
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "cat_name": "Updated by admin",
  "weight": 4.2
}

### Admin: delete any cat
DELETE {{baseUrl}}/cats/{{otherCatId}}
Authorization: Bearer {{loginAdmin.response.body.token}}

### Admin: update any user
PUT {{baseUrl}}/users/{{otherUserId}}
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "name": "Updated by admin",
  "role": "user"
}

### Admin: delete any user and their cats
DELETE {{baseUrl}}/users/{{otherUserId}}
Authorization: Bearer {{loginAdmin.response.body.token}}


### Error handler: unknown route
GET {{baseUrl}}/does-not-exist

### Error handler: invalid cat ID
GET {{baseUrl}}/cats/not-a-number

### Error handler: invalid user ID
GET {{baseUrl}}/users/not-a-number

### Error handler: malformed JSON
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Broken Request",
  "username": "broken-request"
}
### Error handler: missing login body
POST {{baseUrl}}/auth/login
Content-Type: application/json

### Error handler: database constraint violation
# Run after the regular-user registration request. Reusing an existing username
# should be rejected by the database and routed to the error handler.
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Duplicate User",
  "username": "{{username}}",
  "email": "duplicate@example.com",
  "role": "user",
  "password": "duplicate-password"
}
