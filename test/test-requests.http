### get cats
GET http://127.0.0.1:3000/api/v1/cats

### get cat with id
GET http://127.0.0.1:3000/api/v1/cats/41

### get cats by user id
GET http://127.0.0.1:3000/api/v1/cats/user/37

### post cat
POST http://127.0.0.1:3000/api/v1/cats
Content-Type: application/json

{
  "cat_name": "Buffy",
  "birthdate": "2022-04-20",
  "weight": 3.5,
  "owner": 37,
  "filename": "/images/200.jpg"
}

### put cat
PUT http://127.0.0.1:3000/api/v1/cats/41
Content-Type: application/json

{
  "cat_name": "Buffy",
  "birthdate": "2022-04-20",
  "weight": 3.5,
  "owner": 37,
  "filename": "/images/200.jpg"
}

### delete cat
DELETE http://127.0.0.1:3000/api/v1/cats/43

### get users
GET http://127.0.0.1:3000/api/v1/users

### get user with id
GET http://127.0.0.1:3000/api/v1/users/37

### post user
POST http://127.0.0.1:3000/api/v1/users
Content-Type: application/json

{
  "name": "Blob",
  "username": "blobbo",
  "email": "blob@metropolia.fi",
  "role": "user",
  "password": "password"
}

### put user
PUT http://127.0.0.1:3000/api/v1/users/37
Content-Type: application/json

{
  "name": "Blob",
  "username": "blobbo",
  "email": "blob@metropolia.fi",
  "role": "user",
  "password": "password"
}

### delete user
DELETE http://127.0.0.1:3000/api/v1/users/38


### file upload
POST http://127.0.0.1:3000/api/v1/cats HTTP/1.1
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="name"

Misu
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2023-10-08
--MyBoundary
Content-Disposition: form-data; name="weight"

6
--MyBoundary
Content-Disposition: form-data; name="owner"

3602
--MyBoundary
Content-Disposition: form-data; name="cat"; filename="cat_test.png"
Content-Type: image/png

< ./cat_test.png
--MyBoundary--
